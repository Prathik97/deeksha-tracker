{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/*"],
      "@adapters/*": ["../adapters/*"],
      "@data/*": ["../data/*"],
      "@/*": ["./*"],
      "date-fns-tz": ["./node_modules/date-fns-tz"],
      "date-fns": ["./node_modules/date-fns"],
      "ajv": ["./node_modules/ajv"],
      "@vercel/kv": ["./node_modules/@vercel/kv"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../core/**/*.ts", "../adapters/**/*.ts"],
  "exclude": ["node_modules", "../core/cli.ts"]
}
