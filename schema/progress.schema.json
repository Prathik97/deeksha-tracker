{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deeksha.example/schema/progress.schema.json",
  "title": "Progress",
  "description": "A devotee's daily log for one enrollment. Pradakshina count is derived from pradakshina_dates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["enrollment_id", "is_complete", "pradakshina_dates", "special_actions_done", "days"],
  "properties": {
    "enrollment_id": { "type": "string", "minLength": 1 },
    "is_complete": { "type": "boolean" },
    "pradakshina_dates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/date" }
    },
    "special_actions_done": {
      "type": "object",
      "propertyNames": { "pattern": "^day_[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z0-9_]+$" },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "days": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "additionalProperties": { "$ref": "#/definitions/day_entry" }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "day_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day_number", "entry_status", "logged_at", "rules_checked",
        "flags", "mantra_method", "pradakshina_done", "notes"
      ],
      "properties": {
        "day_number": { "type": "integer", "minimum": 1 },
        "entry_status": { "type": "string", "enum": ["on_time", "late"] },
        "logged_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "rules_checked": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_]+$" },
          "additionalProperties": { "type": ["boolean", "null"] }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "mantra_method": { "type": ["string", "null"], "enum": ["video", "manual", null] },
        "pradakshina_done": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
